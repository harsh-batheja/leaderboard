# Example config. Copy to ./config/<name>.env (or any path) and edit.
# Run with:  ./refresh.sh --config <name>           (looks in ./config/<name>.env)
#       or:  ./refresh.sh --config /abs/path.env
#
# All paths and identifiers below are placeholders.

# Local clone of the target repo (must be kept up to date — refresh.sh does NOT pull)
export REPO_DIR="${REPO_DIR:-$HOME/projects/MYREPO}"

# GitHub owner/name (used by `gh api graphql` for PR + review data)
export REPO_OWNER="${REPO_OWNER:-MYORG}"
export REPO_NAME="${REPO_NAME:-MYREPO}"

# Where intermediate TSV/JSONL/JSON files land
export DATA_DIR="${DATA_DIR:-/tmp/_data}"

# Where the rendered HTML lands
export OUT_DIR="${OUT_DIR:-$HOME/projects/leaderboard/out}"
export OUT_FILE="${OUT_FILE:-$OUT_DIR/index.html}"

# Display strings on the page
export PAGE_TITLE="${PAGE_TITLE:-Contributor Impact}"
export PAGE_SUBTITLE="${PAGE_SUBTITLE:-MYORG/MYREPO}"
export REPO_FIRST_COMMIT="${REPO_FIRST_COMMIT:-2024-01-01}"

# ─── Feature flags (default OFF — opt-in to contested signals) ────────────────

# Show per-author Iteration column (% of your PRs that another author later
# touched with a "fix:" PR or revert within 30d). Honest signal, but hot-file
# work shows higher rates regardless of skill — read the in-page methodology
# before turning this on for a team.
# export SHOW_ITERATION=1

# Show "Possible re-implementation pairs" panel: closed-PR vs merged-PR file
# overlap above a threshold. Heuristic only, surfaces parallel work too.
# export SHOW_SIMILARITY=1

# Auto-shift PR credit between contributors based on similarity flags.
# Requires SHOW_SIMILARITY=1. Off by default — propagates flag false positives
# into leaderboard numbers. The page shows a header badge when active.
# export SIMILARITY_CREDIT_DELTA=1
# export SIMILARITY_DELTA_CAP=0.4

# ─── Tunables (only used when their feature is enabled) ───────────────────────

# Iteration window (days) and minimum shared files to count as "iterated on"
# export ITERATION_WINDOW_DAYS=30
# export ITERATION_MIN_SHARED=2

# Standouts cards — comma-separated codes, in render order. Duplicate-author
# dedup is applied (the same person never wins two adjacent cards).
# Available codes:
#   top_impact         max weighted_lines       — quality-weighted lines
#   top_reviewer       max reviews              — reviews on others' PRs
#   highest_output     max commits              — merge-strategy biased
#   most_prs           max prs (credit)         — split by commit-author share
#   most_prs_opened    max prs_raw              — raw PR opener count
#   highest_volume     max add                  — raw lines added
#   biggest_cleanup    max del                  — lines deleted
#   broadest_reach     max files                — distinct files touched
#   most_iterated      max iteration_count      — requires SHOW_ITERATION=1
#   cleanest_shipper   min iteration_rate (N≥5) — requires SHOW_ITERATION=1
# Default (when unset): top_impact,top_reviewer,highest_output,most_prs
# export STANDOUTS="top_impact,top_reviewer,most_prs,broadest_reach"

# ─── Optional integrations ────────────────────────────────────────────────────

# JSON file mapping git author names → GitHub logins, e.g.
#   {"Display Name": "gh_login", "Other Name": "other_login"}
# Used to join commit data (by author name) with PR/review data (by gh login).
# export IDENTITIES_FILE="$HOME/.config/leaderboard/identities.json"

# JSON array of names/logins to exclude from all stats (bots, AI reviewers).
# Format: ["bot-name-1", "bot-name-2"]
# export BOTS_FILE="$HOME/.config/leaderboard/bots.json"

# GitHub login of an automation account whose merged PRs should be re-attributed
# to the human who filed the originating issue.  pull_all_data.sh scans each PR
# body / linked issue for "Requested by @user", "Reported by @user", etc.
# export TRIGGER_BOT_LOGIN=""

# Optional JSON map for short @mentions in trigger-bot PR/issue bodies that
# don't match a real GitHub login. Format: {"shortname": "gh_login"}
# export TRIGGER_BOT_MENTIONS_FILE="$HOME/.config/leaderboard/trigger-bot-mentions.json"

# rsync target for `refresh.sh --deploy`. Format: user@host:/path/
# export DEPLOY_TARGET=""
